// 23 - Assessment-report IOCs in Netscaler_CL: new IPs and 194.127.166.0/24, q8k1vi/vadmv1 stagers, forged SAML (idp.test.local, InResponseTo, M0M0 padding), e6ee7c85/.slap.receiver/x.php probes. ('receiver' term is noisy; filter results to real IOCs.)
let ips = dynamic(["213.209.159.55","81.94.239.8","45.137.99.92","162.33.177.119","167.88.172.6","5.83.144.60","23.234.80.205","54.194.246.240","79.133.42.141","68.235.46.82","23.234.88.25","23.234.94.126","146.70.211.157","138.199.60.36","37.19.221.148"]);
let terms = dynamic(["q8k1vi","vadmv1","27275938c062f90f","c896411e0cbc1ae9","idp.test.local","_02558a7ac3d8c9c4e9ed3b3569cbf51b","02558a7ac3d8c9c4e9ed3b3569cbf51b","e6ee7c85","receiver","x.php","M88npieBFw","tmindex.html"]);
Netscaler_CL | where TimeGenerated > ago(45d)
| where Message has_any (ips) or Message has_any (terms) or Message contains "194.127.166." or Message contains "M0M0M0M0" or Message contains "slap."
| extend IOC = case(Message contains "q8k1vi","q8k1vi", Message contains "vadmv1","vadmv1", Message contains "idp.test.local" or Message contains "02558a7ac3d8","forged-SAML", Message contains "M0M0M0M0","SAML-M0-padding", Message contains "e6ee7c85","e6ee7c85.ico", Message contains "slap.","slap.receiver", Message contains "x.php","x.php", Message contains "194.127.166.","194.127.166.0/24", Message contains "NSPPE","username-injection", tostring(extract(@"(\d+\.\d+\.\d+\.\d+)",1,Message)))
| extend IPhit = extract(@"((?:213\.209\.159\.55|81\.94\.239\.8|45\.137\.99\.92|162\.33\.177\.119|167\.88\.172\.6|5\.83\.144\.60|23\.234\.80\.205|54\.194\.246\.240|79\.133\.42\.141|68\.235\.46\.82|23\.234\.88\.25|23\.234\.94\.126|146\.70\.211\.157|138\.199\.60\.36|37\.19\.221\.148|194\.127\.166\.\d+))",1,Message)
| summarize n=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), sample=take_any(substring(CitrixAdcMessage_s,0,250)) by CitrixAdcHostname_s, IOC=iff(IOC=="username-injection" or isempty(IPhit), IOC, strcat(IOC," ip=",IPhit)), CitrixAdcModule_s, CitrixAdcEventType_s
| order by FirstSeen asc
