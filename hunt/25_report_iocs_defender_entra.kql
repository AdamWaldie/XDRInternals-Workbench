// 25 - Report IOC IPs in Defender for Endpoint, Cloud Apps, Entra sign-ins, Defender for Identity and email (ASOS Prod workspace).
let ips = dynamic(["213.209.159.55","81.94.239.8","45.137.99.92","162.33.177.119","167.88.172.6","5.83.144.60","23.234.80.205","54.194.246.240","79.133.42.141","68.235.46.82","23.234.88.25","23.234.94.126","146.70.211.157","138.199.60.36","37.19.221.148"]);
union isfuzzy=true
 (DeviceNetworkEvents | where TimeGenerated > ago(45d) | where RemoteIP in (ips) or ipv4_is_in_range(RemoteIP,"194.127.166.0/24") | summarize n=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by T="DeviceNetworkEvents", IP=RemoteIP, Who=DeviceName, What=strcat(ActionType," ",RemotePort," ",InitiatingProcessFileName)),
 (CloudAppEvents | where TimeGenerated > ago(45d) | where IPAddress in (ips) or ipv4_is_in_range(IPAddress,"194.127.166.0/24") | summarize n=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by T="CloudAppEvents", IP=IPAddress, Who=AccountDisplayName, What=ActionType),
 (SigninLogs | where TimeGenerated > ago(45d) | where IPAddress in (ips) or ipv4_is_in_range(IPAddress,"194.127.166.0/24") | summarize n=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by T="SigninLogs", IP=IPAddress, Who=UserPrincipalName, What=ResultType),
 (AADNonInteractiveUserSignInLogs | where TimeGenerated > ago(45d) | where IPAddress in (ips) | summarize n=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by T="AADNonInteractive", IP=IPAddress, Who=UserPrincipalName, What=ResultType),
 (IdentityLogonEvents | where TimeGenerated > ago(45d) | where IPAddress in (ips) | summarize n=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by T="IdentityLogonEvents", IP=IPAddress, Who=AccountUpn, What=ActionType),
 (EmailEvents | where TimeGenerated > ago(45d) | where SenderIPv4 in (ips) | summarize n=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by T="EmailEvents", IP=SenderIPv4, Who=RecipientEmailAddress, What=Subject)
