// 03 - SSL/DTLS handshake failure profile by version and reason (look for DTLSv1.0 + 'Handshake failure-Internal Error').
Netscaler_CL | where TimeGenerated > ago(45d)
| where CitrixAdcEventType_s == "SSL_HANDSHAKE_FAILURE"
| extend ClientVersion=extract(@"ClientVersion (\S+)",1,CitrixAdcMessage_s), Reason=extract(@"(Handshake failure[^-\n]*|Reason [^\n]*)",1,CitrixAdcMessage_s), ClientIP=extract(@"ClientIP (\S+)",1,CitrixAdcMessage_s)
| summarize n=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), ips=dcount(ClientIP) by CitrixAdcHostname_s, ClientVersion, Reason | order by n desc
