{
    "manifest_version": 3,
    "name": "XDR Docker Relay",
    "version": "1.0",
    "description": "Relays your signed-in Microsoft Defender XDR session into a locked-down XDRInternals Docker container.",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "cookies",
        "storage"
    ],
    "host_permissions": [
        "https://security.microsoft.com/*",
        "https://login.microsoftonline.com/*",
        "http://127.0.0.1/*"
    ]
}
